global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: node
    static_configs:
{% for host in groups['controller'] + groups['compute'] %}
      - targets: ["{{ hostvars[host].ansible_host }}:9100"]
        labels:
          node: "{{ host }}"
{% endfor %}
{% for host in groups['gpu'] %}
      - targets: ["127.0.0.1:9100"]
        labels:
          node: "{{ host }}"
{% endfor %}
