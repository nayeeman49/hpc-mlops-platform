#cloud-config
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true
preserve_hostname: false
ssh_pwauth: false
package_update: false
package_upgrade: false

users:
  - name: ${ssh_user}
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_key}

packages:
  - qemu-guest-agent

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
